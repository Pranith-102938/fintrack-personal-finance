# ==========================================
# Personal Finance Tracker Environment Setup
# ==========================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas Connection String)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/finance_tracker?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/finance_tracker?retryWrites=true&w=majority

# JWT Authentication Secret Key (Generate a strong 64+ char random string)
JWT_SECRET=super_secret_jwt_production_key_change_me_in_prod_894327589327498

# Allowed CORS Origins (comma separated for production backend server)
ALLOWED_ORIGINS=https://your-finance-tracker.vercel.app,http://localhost:5000
